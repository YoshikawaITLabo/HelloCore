@page
@model HelloCore.Pages.CustomerEditModel
@{
    ViewData["Title"] = "顧客編集";
}

<h1>顧客編集</h1>

<p style="color:red">@Model.Message</p>

<form method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label class="form-label">ID</label>
        <input class="form-control" value="@Model.Id" readonly />
    </div>
    <div class="mb-3">
        <label class="form-label">名前</label>
        <input asp-for="Name" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">電話</label>
        <input asp-for="Tel" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">更新</button>
    <button type="submit" class="btn btn-danger" asp-page-handler="Delete"
            onclick="return confirm('この顧客を削除します。よろしいですか？');">
        削除
    </button>
    <a asp-page="Customers">一覧へ戻る</a>
</form>